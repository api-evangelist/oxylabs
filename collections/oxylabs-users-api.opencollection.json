        {
          "info": {
            "name": "Get client statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://realtime.oxylabs.io/v1/users/:userId/client-stats",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
