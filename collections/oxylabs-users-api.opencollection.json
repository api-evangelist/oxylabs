{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oxylabs Web Intelligence APIs Login Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sub-users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://realtime.oxylabs.io/v1/users/:userId/sub-users",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List sub-users"
        },
        {
          "info": {
            "name": "Create a sub-user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://realtime.oxylabs.io/v1/users/:userId/sub-users",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a sub-user"
        },
        {
          "info": {
