              {
                "name": "userId",
                "value": "",
                "type": "path"
              },
              {
                "name": "subUserId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get sub-user"
        },
        {
          "info": {
            "name": "Update sub-user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://realtime.oxylabs.io/v1/users/:userId/sub-users/:subUserId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              },
              {
                "name": "subUserId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update sub-user"
        },
        {
          "info": {
            "name": "Delete sub-user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://realtime.oxylabs.io/v1/users/:userId/sub-users/:subUserId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              },
              {
                "name": "subUserId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete sub-user"
        },
        {
          "info": {
