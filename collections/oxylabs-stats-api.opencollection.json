{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oxylabs Web Intelligence APIs Login Stats API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List statistics filter instances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://realtime.oxylabs.io/v1/stats/v1/filters/instances",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List statistics filter instances"
        },
        {
          "info": {
            "name": "Get usage statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://realtime.oxylabs.io/v1/stats/v1/usage",
            "params": [
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get usage statistics"
        }
      ]
    }
  ],
  "bundled": true
}